DATABASE_URL=sqlite+aiosqlite:///./skillquest.db
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional fallback chain if OLLAMA_MODEL is not installed locally.
# Comma-separated, tried in order. Keep lightweight models here.
OLLAMA_FALLBACK_MODELS=gemma2:2b,phi3:mini

# Optional: used when Ollama is down or returns invalid JSON. Few-shot history improves prompts per domain.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# D-ID avatar streaming (get key at https://studio.d-id.com — paste the raw API key only)
DID_API_KEY=
# Optional: custom presenter image URL for the D-ID avatar
DID_PRESENTER_URL=https://create-images-results.d-id.com/DefaultPresenters/Noelle_f/thumbnail.jpeg

# Public-facing URL of this backend so D-ID can fetch your local avatar image.
# Drop your photo as backend/public/avatar.jpg, then expose the backend with ngrok:
#   ngrok http 8000
# and paste the https URL here. Leave blank to use DID_PRESENTER_URL.
BACKEND_PUBLIC_URL=

# ElevenLabs — fallback interviewer voice when D-ID is missing or fails (2D avatar + server TTS).
# Get a key at https://elevenlabs.io — optional; if unset, the app uses browser speech synthesis.
ELEVENLABS_API_KEY=
# Optional: voice ID from ElevenLabs Voice Library (default below is "Rachel").
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Performance: serve quiz questions from DB pool first (fast). Set false to always call LLMs.
QUESTION_POOL_FIRST=true
# PostgreSQL/MySQL pool (ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=24
